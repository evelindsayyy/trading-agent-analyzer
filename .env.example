# Copy to .env and fill in. The web app runs on DeepSeek by default.

# --- Required: LLM key (DeepSeek powers both analysis and the cheatsheet) ---
DEEPSEEK_API_KEY=

# --- Optional: data vendor keys (reports degrade gracefully without them) ---
# FRED_API_KEY=        # macro indicators (free: https://fred.stlouisfed.org/docs/api/api_key.html)

# --- Optional: web app overrides (defaults shown) ---
# WEBAPP_PASSWORD=                       # shared password gate; empty = open (localhost only)
# WEBAPP_LLM_PROVIDER=deepseek           # provider for analysis + cheatsheet
# WEBAPP_DEEP_MODEL=deepseek-v4-pro      # flagship model for the analysis
# WEBAPP_QUICK_MODEL=deepseek-v4-flash   # fast model for quick steps + cheatsheet
# WEBAPP_REPORTS_ROOT=                   # where reports are read/written (default: ./reports)
# WEBAPP_SKILLS_DIR=                     # cheatsheet prompts dir (default: ./prompts)

# To use a different provider for the whole app instead of DeepSeek, set
# WEBAPP_LLM_PROVIDER + the matching key (e.g. OPENAI_API_KEY / ANTHROPIC_API_KEY)
# and appropriate model names.
