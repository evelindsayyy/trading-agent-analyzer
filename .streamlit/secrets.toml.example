# Streamlit Community Cloud secrets — DO NOT commit a real secrets.toml.
# In the Streamlit Cloud dashboard: App → Settings → Secrets, paste these.
# Locally you can copy this to .streamlit/secrets.toml (gitignored) OR just use .env.
#
# Top-level string values are also exposed to the app as environment variables
# (the app bridges them in webapp/config.py), so DEEPSEEK_API_KEY here behaves
# exactly like setting it in .env.

DEEPSEEK_API_KEY = "sk-your-deepseek-key"

# REQUIRED for a public Cloud deployment — enables read-only demo mode:
# visitors can browse run history + reports, but launching a new analysis or
# generating a cheatsheet (paid LLM calls) requires this passphrase.
WEBAPP_PASSWORD = "choose-a-strong-passphrase"

# Durable storage — REQUIRED on Streamlit Cloud to keep runs (its disk is wiped
# on restart). Paste a free Postgres connection string from Neon or Supabase.
# Without it, every run disappears when the app sleeps/restarts.
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# Optional overrides (defaults shown):
# WEBAPP_LLM_PROVIDER = "deepseek"
# WEBAPP_DEEP_MODEL   = "deepseek-v4-pro"
# WEBAPP_QUICK_MODEL  = "deepseek-v4-flash"
