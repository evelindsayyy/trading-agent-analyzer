# Streamlit Community Cloud secrets — DO NOT commit a real secrets.toml.
# In the Streamlit Cloud dashboard: App → Settings → Secrets, paste these.
# Locally you can copy this to .streamlit/secrets.toml (gitignored) OR just use .env.
#
# Top-level string values are also exposed to the app as environment variables
# (the app bridges them in webapp/config.py), so DEEPSEEK_API_KEY here behaves
# exactly like setting it in .env.

DEEPSEEK_API_KEY = "sk-your-deepseek-key"

# Recommended for a public Cloud deployment — gates access behind a password:
# WEBAPP_PASSWORD = "choose-a-strong-passphrase"

# Optional overrides (defaults shown):
# WEBAPP_LLM_PROVIDER = "deepseek"
# WEBAPP_DEEP_MODEL   = "deepseek-v4-pro"
# WEBAPP_QUICK_MODEL  = "deepseek-v4-flash"
